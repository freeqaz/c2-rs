+  // *contents* are big-endian.
+  IMAGE_FILE_MACHINE_POWERPCBE = 0x1F2,
   IMAGE_FILE_MACHINE_R4000 = 0x166,
   IMAGE_FILE_MACHINE_RISCV32 = 0x5032,
