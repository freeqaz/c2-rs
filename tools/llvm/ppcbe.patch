+      LLVM_COFF_SWITCH_RELOC_TYPE_NAME(IMAGE_REL_PPC_REL14);
+      LLVM_COFF_SWITCH_RELOC_TYPE_NAME(IMAGE_REL_PPC_TOCREL16);
+      LLVM_COFF_SWITCH_RELOC_TYPE_NAME(IMAGE_REL_PPC_TOCREL14);
+      LLVM_COFF_SWITCH_RELOC_TYPE_NAME(IMAGE_REL_PPC_ADDR32NB);
+      LLVM_COFF_SWITCH_RELOC_TYPE_NAME(IMAGE_REL_PPC_SECREL);
+      LLVM_COFF_SWITCH_RELOC_TYPE_NAME(IMAGE_REL_PPC_SECTION);
+      LLVM_COFF_SWITCH_RELOC_TYPE_NAME(IMAGE_REL_PPC_IFGLUE);
+      LLVM_COFF_SWITCH_RELOC_TYPE_NAME(IMAGE_REL_PPC_IMGLUE);
+      LLVM_COFF_SWITCH_RELOC_TYPE_NAME(IMAGE_REL_PPC_SECREL16);
+      LLVM_COFF_SWITCH_RELOC_TYPE_NAME(IMAGE_REL_PPC_REFHI);
+      LLVM_COFF_SWITCH_RELOC_TYPE_NAME(IMAGE_REL_PPC_REFLO);
+      LLVM_COFF_SWITCH_RELOC_TYPE_NAME(IMAGE_REL_PPC_PAIR);
+      LLVM_COFF_SWITCH_RELOC_TYPE_NAME(IMAGE_REL_PPC_SECRELLO);
+      LLVM_COFF_SWITCH_RELOC_TYPE_NAME(IMAGE_REL_PPC_SECRELHI);
+      LLVM_COFF_SWITCH_RELOC_TYPE_NAME(IMAGE_REL_PPC_GPREL);
+      LLVM_COFF_SWITCH_RELOC_TYPE_NAME(IMAGE_REL_PPC_TOKEN);
+    default:
+      return "Unknown";
+    }
+    break;
   case Triple::mipsel:
     switch (Type) {
       LLVM_COFF_SWITCH_RELOC_TYPE_NAME(IMAGE_REL_MIPS_ABSOLUTE);
