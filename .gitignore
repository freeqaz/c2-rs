# Rust build output
/target

# c2host build cache — the x86 stub is built on demand from c2host/c2host.c
# (which IS tracked). The compiled .exe is machine-specific and NEVER committed.
# (Already covered by /target above; listed explicitly for clarity.)
/target/c2host/

# Captured / generated IL bundles — NEVER commit these. IL is regenerated at
# test time by the reference toolchain (see fixtures/README.md).
_CL_*
*.il

# Compiler output objects
*.obj
*.o

# Scratch / work directories used by the harness and tests
/work
/.c2rs-work
**/*.tmp

# P1.2 generated corpus — captured (source, IL-bundle, obj) triples. The `.gl`
# embeds the host source path and the obj embeds its output path, so a captured
# corpus is NEVER committable; it is a regenerable artifact (`c2rs corpus gen`).
# Only the generator, docs/CORPUS_MVP.md, and the hand-built synthetic sample
# (crates/c2-harness/tests/corpus_sample/) are committed.
/corpus/

# Fixtures' .cpp stay tracked (they are the only hand-maintained artifact).

# Paint (LLM-draft bootstrap): MS-binary-derived Ghidra pseudo-C and bulky run
# logs are never committed. The tooling (paint/*.py, README) and the Rust drafts
# (paint/color/*.rs) ARE tracked.
/paint/ghidra_cache/
/paint/runs/

# Python bytecode (paint tooling is Python)
__pycache__/
*.pyc
gens_*.jsonl
