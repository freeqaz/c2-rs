# Rust build output
/target

# c2host build cache — the x86 stub is built on demand from c2host/c2host.c
# (which IS tracked). The compiled .exe is machine-specific and NEVER committed.
# (Already covered by /target above; listed explicitly for clarity.)
/target/c2host/

# c1host build cache — same story for the front-end (c1xx.dll) replay stub,
# built on demand from c1host/c1host.c (tracked). The .exe and the 1033/
# resources symlink beside it are machine-specific and NEVER committed.
/target/c1host/

# Captured / generated IL bundles — NEVER commit these. IL is regenerated at
# test time by the reference toolchain (see fixtures/README.md).
_CL_*
*.il

# Compiler output objects
*.obj
*.o

# Scratch / work directories used by the harness and tests
/work
/.c2rs-work
**/*.tmp

# P1.2 generated corpus — captured (source, IL-bundle, obj) triples. The `.gl`
# embeds the host source path and the obj embeds its output path, so a captured
# corpus is NEVER committable; it is a regenerable artifact (`c2rs corpus gen`).
# Only the generator, docs/CORPUS_MVP.md, and the hand-built synthetic sample
# (crates/c2-harness/tests/corpus_sample/) are committed.
/corpus/

# Fixtures' .cpp stay tracked (they are the only hand-maintained artifact).

# Reference toolchain binaries fetched by scripts/fetch_compilers.sh — these
# are Microsoft binaries and must NEVER be committed.
/compilers/
# …and the same path as a SYMLINK, which is what a configured worktree has
# (scripts/configure_existing_worktree.sh links it to the main repo). The trailing
# slash above matches a directory ONLY, so in every worktree `git status` showed
# `?? compilers` and a `git add -A` would have committed a symlink containing an
# absolute machine path — the one thing CLAUDE.md says never to commit. Found by a
# reviewer running `git check-ignore` in a configured worktree rather than assuming.
/compilers

# Paint (LLM-draft bootstrap): entirely UNTRACKED. It contains Ghidra pseudo-C
# decompiled from the proprietary MS c2.dll and LLM drafts derived from it
# (self-labeled "NOT clean-room code / DO NOT SHIP"), so it must never enter the
# clean-room repo or its (public) history. Kept on disk locally, ignored here.
/paint/

# Python bytecode (paint tooling is Python)
__pycache__/
*.pyc
gens_*.jsonl

# Git worktrees created by scripts/setup_worktree.sh (and by Claude Code's own
# worktree isolation). Each is a real checkout with a reflinked target/ and a
# symlinked compilers/ — never committed.
/.claude/worktrees/
