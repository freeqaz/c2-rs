== Z2-r2k4  vs  Z6-r2k4   (the TIGHTER pair — a second name, used nowhere)
   sizes 892 / 892
   differing bytes with TimeDateStamp (4..8) zeroed: 8
      off 0x0231   60 -> 40
      off 0x0235   43 -> 63
      off 0x0239   63 -> 43
      off 0x023d   63 -> 43
      off 0x0241   63 -> 43
      off 0x0245   63 -> 43
      off 0x0249   43 -> 63
      off 0x024d   43 -> 63
   -- Z2-r2k4
      li 11, 7
      addi 10, 3, 48
      stw 11, 0(3)
      stw 11, 4(3)
      stw 11, 8(3)
      stw 11, 12(3)
      stw 10, 48(3)
      stw 10, 52(3)
      blr
   -- Z6-r2k4
      li 10, 7
      addi 11, 3, 48
      stw 10, 0(3)
      stw 10, 4(3)
      stw 10, 8(3)
      stw 10, 12(3)
      stw 11, 48(3)
      stw 11, 52(3)
      blr

