+// ==== SCRATCH — lane w-glattrs, MEASUREMENT ONLY, never shipped ====
+/// One `.gl` function record, decoded by `gl_function_attrs`' OWN walk (the
+/// incumbent `gl_offset_framed`, so the population is exactly the one the
+/// shipped reader sees), with the `SIZE` field decoded per `il-read-varint16`
+/// (`0x10c1f9a6`) instead of refused.
+pub(super) struct ScratchGlRec {
+    pub name: String,
+    pub size: usize,
+    /// `direct` (< 0x80, one byte) · `escape` (`80 <LE16>`, three bytes) ·
+    /// `high` (0x81..=0xff, one signed byte — what c2 does, what the port
+    /// refuses).
+    pub size_form: &'static str,
+    /// The ATTR byte the NEW decode reads.
+    pub attr_new: Option<u8>,
+    /// The incumbent reader refuses the whole file on this record.
+    pub blocked_incumbent: bool,
+    /// The NEW reader still refuses the whole file on this record.
+    pub blocked_new: bool,
+}
+
+/// Re-expressed here rather than widening `c2-il`'s API, because this block is
+/// reverted before the gate. Mirrors `gl_function_attrs` byte for byte except
+/// that the `SIZE` arm decodes instead of returning `None`.
+pub(super) fn scratch_gl_records(gl: &[u8]) -> Vec<ScratchGlRec> {
+    let is_sep = |b: u8| b == 0 || b == 0x26;
+    let mut runs: Vec<(usize, usize, String)> = Vec::new();
+    let mut i = 0usize;
+    while i < gl.len() {
+        if !is_sep(gl[i]) {
+            i += 1;
+            continue;
+        }
+        let start = i + 1;
+        let mut end = start;
+        while end < gl.len() && !is_sep(gl[end]) {
+            end += 1;
+        }
+        if end >= gl.len() || end == start {
+            i += 1;
+            continue;
+        }
+        let b = &gl[start..end];
+        if b.iter().all(|c| c.is_ascii_graphic())
+            && (b[0] == b'?' || b[0].is_ascii_alphabetic() || b[0] == b'_')
+        {
+            runs.push((start, end, String::from_utf8_lossy(b).into_owned()));
+        }
+        i = end;
+    }
+    // THE INCUMBENT framing, deliberately: this measures the population the
+    // shipped reader walks, not the one #2783's relaxed framing would.
+    let framed = |o: usize| -> bool {
+        o >= 7
+            && o < gl.len()
+            && gl[o] == 0x80
+            && gl[o - 7] == 0x80
+            && gl[o - 5] == 0x10
+            && gl[o - 4] == 0x00
+            && gl[o - 3] == 0x00
+            && gl[o - 2] == 0x00
+            && gl[o - 1] == 0x00
+    };
+    let mut out: Vec<ScratchGlRec> = Vec::new();
+    let mut p = 0usize;
+    while p + 5 <= gl.len() {
+        if !framed(p) {
+            p += 1;
+            continue;
+        }
+        let Some(k) = runs.iter().rposition(|&(_, e, _)| e <= p) else {
+            // `gl_function_attrs` refuses the FILE here. Recorded as such.
+            out.push(ScratchGlRec {
+                name: String::new(),
+                size: 0,
+                size_form: "noname",
+                attr_new: None,
+                blocked_incumbent: true,
+                blocked_new: true,
+            });
+            p += 5;
+            continue;
+        };
+        if p - runs[k].1 > 64 {
+            out.push(ScratchGlRec {
+                name: String::new(),
+                size: 0,
+                size_form: "noname",
+                attr_new: None,
+                blocked_incumbent: true,
+                blocked_new: true,
+            });
+            p += 5;
+            continue;
+        }
+        let mut q = p + 5;
+        // SRCPOS: a byte under 0x80, or the escape `80 <LE32>`. Unchanged.
+        match gl.get(q) {
+            Some(&b) if b < 0x80 => q += 1,
+            Some(&0x80) => q += 5,
+            _ => {
+                out.push(ScratchGlRec {
+                    name: runs[k].2.clone(),
+                    size: 0,
+                    size_form: "srcpos-high",
+                    attr_new: None,
+                    blocked_incumbent: true,
+                    blocked_new: true,
+                });
+                p += 5;
+                continue;
+            }
+        }
+        // SIZE, by `0x10c1f9a6`: exactly `0x80` escapes to a little-endian u16;
+        // everything else is ONE byte, read by c2 as a signed char.
+        let (size, form, blocked_inc, blocked_new) = match gl.get(q) {
+            Some(&0x80) => match (gl.get(q + 1), gl.get(q + 2)) {
+                (Some(&lo), Some(&hi)) => {
+                    q += 3;
+                    (lo as usize | ((hi as usize) << 8), "escape", true, false)
+                }
+                _ => {
+                    p += 5;
+                    continue;
+                }
+            },
+            Some(&b) if b < 0x80 => {
+                q += 1;
+                (b as usize, "direct", false, false)
+            }
+            Some(&b) => {
+                q += 1;
+                (b as usize, "high", true, true)
+            }
+            None => break,
+        };
+        out.push(ScratchGlRec {
+            name: runs[k].2.clone(),
+            size,
+            size_form: form,
+            attr_new: gl.get(q).copied(),
+            blocked_incumbent: blocked_inc || gl.get(q).is_none(),
+            blocked_new: blocked_new || gl.get(q).is_none(),
+        });
+        p += 5;
+    }
+    out
+}
