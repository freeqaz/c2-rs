+// ***** w-jump SCRATCH INSTRUMENT — REVERTED, NEVER COMMITTED *****
+// Explodes the `expr-jump` first-blocker key into a compound key carrying every
+// axis this lane wants to decompose on, so ONE scan decides all of them offline
+// and both columns sum to the family total by construction.
+fn wjump_key(f: &c2_il::func::FnCensus) -> String {
+    let k = f.verdict.key();
+    if k != "expr-jump" && !k.starts_with("ctr-loop-") {
+        return k;
+    }
+    let hex: String = f.hex.iter().map(|b| format!("{b:02X}")).collect();
+    format!(
+        "{k}|{}|{}|{}|{}|{}|{}|{}|{}",
+        f.cflow,
+        f.dispatch,
+        f.calls,
+        f.seg_len,
+        f.hex_mark,
+        hex,
+        f.index,
+        f.name.as_deref().or(f.emit_name.as_deref()).unwrap_or("-")
+    )
+}
+
