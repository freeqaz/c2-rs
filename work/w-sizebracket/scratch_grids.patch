+// ==== SCRATCH — lane w-sizebracket, MEASUREMENT ONLY, never shipped ====
+/// The `.gl` **function** record's `SIZE` field, per defined function.
+///
+/// This is `[sym+0x50]` — the 16-bit quantity c2's inline candidacy test reads
+/// at `0x10b5fc86` and compares against `DAT_10c46318` at `0x10b5fc8a`.  It is
+/// written by the `.gl` record reader `FUN_10b9b8e9` at `0x10b9bf6c`
+/// (`66 89 46 50`, the ONLY 16-bit store to `+0x50` in the whole image), from
+/// `0x10c1f9a6` — the `il-read-varint16` reader — three fields before the emit
+/// flag word `[sym+0x4c]` the same pass writes at `0x10b9bf78`.
+///
+/// It is the field `c2_il::func::gl::gl_function_attrs`' own record comment
+/// already calls `SIZE` and steps over to reach `ATTR`.  That reader **refuses
+/// the whole file** when the byte is `>= 0x80`; this one decodes the `0x80`
+/// escape instead, because how often the refusal fires is one of the things
+/// this lane measures.
+fn scratch_gl_sizes(gl: &[u8]) -> std::collections::BTreeMap<String, (usize, bool)> {
+    // `c2_il`'s `symbol_runs` and `gl_offset_framed` are private to that crate;
+    // re-expressed here rather than widened, because this block is reverted.
+    let is_sep = |b: u8| b == 0 || b == 0x26;
+    let mut runs: Vec<(usize, usize, String)> = Vec::new();
+    let mut i = 0usize;
+    while i < gl.len() {
+        if !is_sep(gl[i]) {
+            i += 1;
+            continue;
+        }
+        let start = i + 1;
+        let mut end = start;
+        while end < gl.len() && !is_sep(gl[end]) {
+            end += 1;
+        }
+        if end >= gl.len() || end == start {
+            i += 1;
+            continue;
+        }
+        let b = &gl[start..end];
+        if b.iter().all(|c| c.is_ascii_graphic())
+            && (b[0] == b'?' || b[0].is_ascii_alphabetic() || b[0] == b'_')
+        {
+            runs.push((start, end, String::from_utf8_lossy(b).into_owned()));
+        }
+        i = end;
+    }
+    // `codec::gl_offset_framed_RELAXED` — board **#2783**'s framing, not the
+    // incumbent one.  The incumbent pins `gl[o-5] == 0x10`, which is a VALUE
+    // window on PREV (a rising per-record counter), so it truncates the record
+    // list at whatever point PREV leaves its first 256 values: 5 of 5 records on
+    // a 2.5 KB `.gl` and 36 of 811 on a 65 KB one.  This lane's first run used
+    // the incumbent and resolved a SIZE for **74 of 7,667** call edges; the
+    // relaxed framing is the one that reads a real workload `.gl`.
+    let framed = |o: usize| -> bool {
+        o >= 7
+            && o + 4 < gl.len()
+            && gl[o] == 0x80
+            && gl[o - 7] == 0x80
+            && gl[o - 4] == 0x00
+            && gl[o - 3] == 0x00
+            && gl[o - 2] == 0x00
+            && gl[o - 1] == 0x00
+            && u32::from_le_bytes([gl[o + 1], gl[o + 2], gl[o + 3], gl[o + 4]]) < 0x0100_0000
+    };
+    let mut out = std::collections::BTreeMap::new();
+    let mut p = 0usize;
+    while p + 5 <= gl.len() {
+        if !framed(p) {
+            p += 1;
+            continue;
+        }
+        let Some(k) = runs.iter().rposition(|&(_, e, _)| e <= p) else {
+            p += 5;
+            continue;
+        };
+        if p - runs[k].1 > 64 {
+            p += 5;
+            continue;
+        }
+        let mut q = p + 5;
+        // SRCPOS: a byte under 0x80, or the escape `80 <LE32>`.
+        match gl.get(q) {
+            Some(&b) if b < 0x80 => q += 1,
+            Some(&0x80) => q += 5,
+            _ => {
+                p += 5;
+                continue;
+            }
+        }
+        // SIZE, by `0x10c1f9a6`: one byte, or `80` then a little-endian u16.
+        let (size, escaped) = match gl.get(q) {
+            Some(&0x80) => match (gl.get(q + 1), gl.get(q + 2)) {
+                (Some(&lo), Some(&hi)) => (lo as usize | ((hi as usize) << 8), true),
+                _ => break,
+            },
+            Some(&b) if b < 0x80 => (b as usize, false),
+            // c2 reads this as a SIGNED char; the port refuses the file here.
+            _ => {
+                p += 5;
+                continue;
+            }
+        };
+        out.entry(runs[k].2.clone()).or_insert((size, escaped));
+        p += 5;
+    }
+    out
+}
