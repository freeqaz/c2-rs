+// ***** w-callprice SCRATCH INSTRUMENT — REVERTED, NEVER COMMITTED *****
+// Every offline axis in the key, so ONE scan decides them all and both columns
+// sum to the family total by construction. `prod` is the axis that has never
+// been crossed with the emitted column.
+fn wcp_key(f: &c2_il::func::FnCensus) -> String {
+    let k = f.verdict.key();
+    if !k.starts_with("expr-call-in-expr") {
+        return k;
+    }
+    let hex: String = f.hex.iter().map(|b| format!("{b:02X}")).collect();
+    format!(
+        "{k}|{}|{}|{}|{}|{}|{}|{}|{}|{}",
+        f.cflow,
+        f.dispatch,
+        f.prod,
+        f.calls,
+        f.seg_len,
+        f.hex_mark,
+        hex,
+        f.index,
+        f.name.as_deref().or(f.emit_name.as_deref()).unwrap_or("-")
+    )
+}
